# ============================================================
# Variables de entorno (plantilla) — estilo Flutter/Dart
# ============================================================
# 1. Copia este archivo a `.env` en la raíz del proyecto (referencia humana / scripts).
# 2. Rellena SOLO la sección de tu stack; borra o deja comentado el resto.
# 3. NUNCA subas `.env` al repositorio (ya está en .gitignore).
# 4. Flutter NO usa NEXT_PUBLIC_ (eso es Next.js). En la app: --dart-define=NOMBRE=valor
#    o un archivo de config (p. ej. lib/config.dart) en compile-time. No cargues .env en el cliente.
# El asistente documentará el stack en docs/database/STACK_DB.md.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://wwhyypadkjjbgkmlbpss.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SEED_PASSWORD=contraseña_de_seed_solo_staging
# Ejemplo Flutter:
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
# Solo backend/scripts — NUNCA en el cliente Flutter ni en dart-define de un APK público
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# CLI link: supabase link --project-ref TU_PROJECT_REF
SUPABASE_PROJECT_REF=wwhyypadkjjbgkmlbpss

# ─── Firebase ────────────────────────────────────────────────
# firebase login + firebase use (CLI); opcional para Admin SDK:
# FIREBASE_PROJECT_ID=tu-proyecto-id
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─── MySQL ───────────────────────────────────────────────────
# Formato: mysql://usuario:contraseña@host:3306/nombre_bd
DATABASE_URL=mysql://usuario:contrasena@localhost:3306/mi_app

