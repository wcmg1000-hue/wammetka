#     # (latest_version, version_code, sha256, apk_url).
#     # Implementación del proyecto: scripts/upload_apk.ps1
#     # - echo "pwsh scripts/upload_apk.ps1"
#     - echo "Publicar APK: ver docs/PUBLISH_APK.md (no poner secretos aquí)"
